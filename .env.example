PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lead email alerts (api/lead.ts). Server-only: set these in Vercel -> Settings -> Environment Variables,
# not in a local .env. The function also reads PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY from Vercel,
# so those two must exist there for Production and Preview.
RESEND_API_KEY=
# While using the Resend sandbox sender this must be the email address the Resend account was created with.
LEAD_NOTIFY_EMAIL=
# Optional. Leave blank to send from onboarding@resend.dev; set once a sending domain is verified in Resend.
LEAD_FROM_EMAIL=
