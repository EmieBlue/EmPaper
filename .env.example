PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lead email alerts (api/lead.ts, sent through Gmail SMTP). Server-only: set these in
# Vercel -> Settings -> Environment Variables, not in a local .env. The function also reads
# PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY from Vercel, so those two must exist there
# for Production and Preview.
# Gmail address that sends the alert. A dedicated account is safest: an app password can send and read that mailbox.
GMAIL_USER=
# 16-character Google App Password for GMAIL_USER (requires 2-Step Verification). Spaces are ignored.
GMAIL_APP_PASSWORD=
# Where alerts are delivered. Can be GMAIL_USER itself or any other address; comma-separate for several.
LEAD_NOTIFY_EMAIL=
