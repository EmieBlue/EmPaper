---
import { navLinks } from './nav-links';
---

<footer class="site-footer">
  <div class="container">
    <hr class="divider" />
    <div class="row">
      <p class="tagline">Your Digital Workplace, All in One.</p>

      <nav class="footer-nav" aria-label="Footer">
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>

      <p class="powered muted">Powered by Empaper</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 2.5rem 3rem;
  }

  .divider {
    margin-bottom: 2rem;
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .tagline {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--color-text);
  }

  .footer-nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-nav a {
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--color-text-secondary);
  }

  .footer-nav a:hover {
    color: var(--color-accent);
  }

  .powered {
    font-size: 0.8125rem;
  }

  @media (max-width: 640px) {
    .row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
