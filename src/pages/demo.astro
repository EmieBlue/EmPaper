---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Demo" description="Book a demo of Empaper for your company.">
  <section>
    <div class="container narrow">
      <p class="eyebrow">Demo</p>
      <h1>Book a demo</h1>

      <form id="demo-form" class="demo-form">
        <label>
          Name
          <input type="text" name="name" required />
        </label>
        <label>
          Company
          <input type="text" name="company" required />
        </label>
        <label>
          Work email
          <input type="email" name="email" required />
        </label>
        <label>
          Number of people
          <input type="number" name="people" min="1" required />
        </label>

        <fieldset class="interests">
          <legend>What are you most interested in? (optional)</legend>
          <label class="checkbox-row">
            <input type="checkbox" name="interests" value="pay_letters" />
            Pay &amp; Letters
          </label>
          <label class="checkbox-row">
            <input type="checkbox" name="interests" value="time_off_holidays" />
            Time Off &amp; Holidays
          </label>
          <label class="checkbox-row">
            <input type="checkbox" name="interests" value="people_directory" />
            People Directory
          </label>
          <label class="checkbox-row">
            <input type="checkbox" name="interests" value="my_info" />
            My Info
          </label>
          <label class="checkbox-row">
            <input type="checkbox" name="interests" value="company_files_announcements" />
            Company Files &amp; Announcements
          </label>
          <label class="checkbox-row">
            <input type="checkbox" name="interests" value="inbox_instant_answers" />
            Inbox &amp; Instant Answers
          </label>
        </fieldset>

        <label>
          Anything else we should know? (optional)
          <textarea name="notes" rows="3"></textarea>
        </label>

        <div class="hp" aria-hidden="true">
          <label>
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <button type="submit" class="btn btn-filled">Book a demo</button>
      </form>

      <div id="demo-confirmation" class="confirmation" hidden>
        <p>We'll write back.</p>
      </div>

      <p id="demo-error" class="form-error" aria-live="polite" hidden>Something went wrong — please try again.</p>
    </div>
  </section>

  <script>
    const form = document.getElementById('demo-form') as HTMLFormElement | null;
    const confirmation = document.getElementById('demo-confirmation');
    const errorMessage = document.getElementById('demo-error');
    const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

    const GENERIC_ERROR = 'Something went wrong — please try again.';
    // Reused across retries so the owner never gets two emails for one submission.
    const submissionId = crypto.randomUUID();

    function showError(message: string) {
      if (!errorMessage) return;
      errorMessage.textContent = message;
      errorMessage.removeAttribute('hidden');
    }

    // Used only when /api/lead isn't deployed (e.g. `astro dev`): the lead is still saved, just without the email alert.
    async function saveDirectly(data: FormData): Promise<boolean> {
      const { supabase } = await import('../lib/supabase');
      const { error } = await supabase.from('leads').insert({
        name: String(data.get('name') ?? ''),
        company_name: String(data.get('company') ?? ''),
        work_email: String(data.get('email') ?? ''),
        number_of_people: Number(data.get('people')),
        interested_features: data.getAll('interests').map(String),
        notes: String(data.get('notes') ?? ''),
      });
      if (error) {
        console.error('Failed to submit demo request', error);
        return false;
      }
      return true;
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorMessage?.setAttribute('hidden', '');
      if (submitButton) submitButton.disabled = true;

      const data = new FormData(form);
      let saved = false;

      try {
        const response = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: data.get('name'),
            company: data.get('company'),
            email: data.get('email'),
            people: data.get('people'),
            interests: data.getAll('interests'),
            notes: data.get('notes'),
            website: data.get('website'),
            submissionId,
          }),
          signal: AbortSignal.timeout(15000),
        });
        const isJson = (response.headers.get('content-type') ?? '').includes('application/json');

        if (response.ok) {
          saved = true;
        } else if (response.status === 404 && !isJson) {
          // The function never ran, so a direct insert can't create a duplicate.
          saved = await saveDirectly(data);
          if (!saved) showError(GENERIC_ERROR);
        } else if (response.status === 400 && isJson) {
          const result = await response.json().catch(() => null);
          showError(typeof result?.message === 'string' ? result.message : GENERIC_ERROR);
        } else {
          showError(GENERIC_ERROR);
        }
      } catch (error) {
        console.error('Failed to submit demo request', error);
        showError(GENERIC_ERROR);
      }

      if (saved) {
        form.hidden = true;
        confirmation?.removeAttribute('hidden');
      } else if (submitButton) {
        submitButton.disabled = false;
      }
    });
  </script>
</BaseLayout>

<style>
  .narrow {
    max-width: 30rem;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin-top: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .demo-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .demo-form[hidden] {
    display: none;
  }

  .demo-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .demo-form input {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 400;
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-text);
  }

  .demo-form input:focus,
  .demo-form textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .demo-form textarea {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 400;
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-text);
    resize: vertical;
  }

  .interests {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .interests legend {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    padding: 0;
    margin-bottom: 0.2rem;
  }

  .demo-form label.checkbox-row {
    flex-direction: row;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--color-text);
  }

  .checkbox-row input {
    accent-color: var(--color-accent);
    width: 1rem;
    height: 1rem;
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 600;
    border: 1.5px solid var(--color-accent);
    background: var(--color-accent);
    color: var(--color-card);
    cursor: pointer;
    margin-top: 0.5rem;
    align-self: flex-start;
  }

  .btn:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  .confirmation {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2rem;
  }

  .confirmation p {
    font-family: var(--font-heading);
    font-size: 1.25rem;
  }

  .form-error {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--color-error);
  }
</style>
