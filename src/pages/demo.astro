---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Demo" description="Book a demo of Empaper for your company.">
  <section>
    <div class="container narrow">
      <p class="eyebrow">Demo</p>
      <h1>Book a demo</h1>

      <form id="demo-form" class="demo-form">
        <label>
          Name
          <input type="text" name="name" required />
        </label>
        <label>
          Company
          <input type="text" name="company" required />
        </label>
        <label>
          Work email
          <input type="email" name="email" required />
        </label>
        <label>
          Number of people
          <input type="number" name="people" min="1" required />
        </label>

        <fieldset class="interests">
          <legend>What are you most interested in? (optional)</legend>
          <label class="checkbox-row">
            <input type="checkbox" name="interests" value="pay_letters" />
            Pay &amp; Letters
          </label>
          <label class="checkbox-row">
            <input type="checkbox" name="interests" value="time_off_holidays" />
            Time Off &amp; Holidays
          </label>
          <label class="checkbox-row">
            <input type="checkbox" name="interests" value="people_directory" />
            People Directory
          </label>
          <label class="checkbox-row">
            <input type="checkbox" name="interests" value="my_info" />
            My Info
          </label>
          <label class="checkbox-row">
            <input type="checkbox" name="interests" value="company_files_announcements" />
            Company Files &amp; Announcements
          </label>
          <label class="checkbox-row">
            <input type="checkbox" name="interests" value="inbox_instant_answers" />
            Inbox &amp; Instant Answers
          </label>
        </fieldset>

        <label>
          Anything else we should know? (optional)
          <textarea name="notes" rows="3"></textarea>
        </label>

        <button type="submit" class="btn btn-filled">Book a demo</button>
      </form>

      <div id="demo-confirmation" class="confirmation" hidden>
        <p>We'll write back.</p>
      </div>

      <p id="demo-error" class="form-error" hidden>Something went wrong — please try again.</p>
    </div>
  </section>

  <script>
    import { supabase } from '../lib/supabase';

    const form = document.getElementById('demo-form') as HTMLFormElement | null;
    const confirmation = document.getElementById('demo-confirmation');
    const errorMessage = document.getElementById('demo-error');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorMessage?.setAttribute('hidden', '');

      const data = new FormData(form);
      const { error } = await supabase.from('leads').insert({
        name: String(data.get('name') ?? ''),
        company_name: String(data.get('company') ?? ''),
        work_email: String(data.get('email') ?? ''),
        number_of_people: Number(data.get('people')),
        interested_features: data.getAll('interests').map(String),
        notes: String(data.get('notes') ?? ''),
      });

      if (error) {
        console.error('Failed to submit demo request', error);
        errorMessage?.removeAttribute('hidden');
        return;
      }

      form.hidden = true;
      confirmation?.removeAttribute('hidden');
    });
  </script>
</BaseLayout>

<style>
  .narrow {
    max-width: 30rem;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin-top: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .demo-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .demo-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .demo-form input {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 400;
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-text);
  }

  .demo-form input:focus,
  .demo-form textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .demo-form textarea {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 400;
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-text);
    resize: vertical;
  }

  .interests {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .interests legend {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    padding: 0;
    margin-bottom: 0.2rem;
  }

  .demo-form label.checkbox-row {
    flex-direction: row;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--color-text);
  }

  .checkbox-row input {
    accent-color: var(--color-accent);
    width: 1rem;
    height: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 600;
    border: 1.5px solid var(--color-accent);
    background: var(--color-accent);
    color: var(--color-card);
    cursor: pointer;
    margin-top: 0.5rem;
    align-self: flex-start;
  }

  .btn:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  .confirmation {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2rem;
  }

  .confirmation p {
    font-family: var(--font-heading);
    font-size: 1.25rem;
  }

  .form-error {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--color-error);
  }
</style>
