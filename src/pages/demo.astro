---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Demo" description="Book a demo of Empaper for your company.">
  <section>
    <div class="container narrow">
      <p class="eyebrow">Demo</p>
      <h1>Book a demo</h1>

      <form id="demo-form" class="demo-form">
        <label>
          Name
          <input type="text" name="name" required />
        </label>
        <label>
          Company
          <input type="text" name="company" required />
        </label>
        <label>
          Work email
          <input type="email" name="email" required />
        </label>
        <label>
          Number of people
          <input type="number" name="people" min="1" required />
        </label>

        <button type="submit" class="btn btn-filled">Book a demo</button>
      </form>

      <div id="demo-confirmation" class="confirmation" hidden>
        <p>We'll write back.</p>
      </div>

      <p id="demo-error" class="form-error" hidden>Something went wrong — please try again.</p>
    </div>
  </section>

  <script>
    import { supabase } from '../lib/supabase';

    const form = document.getElementById('demo-form') as HTMLFormElement | null;
    const confirmation = document.getElementById('demo-confirmation');
    const errorMessage = document.getElementById('demo-error');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorMessage?.setAttribute('hidden', '');

      const data = new FormData(form);
      const { error } = await supabase.from('leads').insert({
        name: String(data.get('name') ?? ''),
        company_name: String(data.get('company') ?? ''),
        work_email: String(data.get('email') ?? ''),
        number_of_people: Number(data.get('people')),
      });

      if (error) {
        console.error('Failed to submit demo request', error);
        errorMessage?.removeAttribute('hidden');
        return;
      }

      form.hidden = true;
      confirmation?.removeAttribute('hidden');
    });
  </script>
</BaseLayout>

<style>
  .narrow {
    max-width: 30rem;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin-top: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .demo-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .demo-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .demo-form input {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 400;
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid color-mix(in srgb, var(--color-gold) 50%, transparent);
    background: var(--color-card);
    color: var(--color-ink);
  }

  .demo-form input:focus {
    outline: none;
    border-color: var(--color-seal);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 600;
    border: 1.5px solid var(--color-seal);
    background: var(--color-seal);
    color: var(--color-card);
    cursor: pointer;
    margin-top: 0.5rem;
    align-self: flex-start;
  }

  .btn:hover {
    background: var(--color-seal-dark);
    border-color: var(--color-seal-dark);
  }

  .confirmation {
    background: var(--color-card);
    border: 1px solid color-mix(in srgb, var(--color-gold) 35%, transparent);
    border-radius: var(--radius-md);
    padding: 2rem;
  }

  .confirmation p {
    font-family: var(--font-heading);
    font-size: 1.25rem;
  }

  .form-error {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: #a33b2a;
  }
</style>
