---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Pricing" description="One plan. Price per company. Payslip, letter, and details included.">
  <section>
    <div class="container">
      <p class="eyebrow">Pricing</p>
      <h1>One plan. Price per company.</h1>

      <div class="price-card">
        <!-- TODO: replace with the real price before launch. Not fabricated — left as an explicit placeholder. -->
        <p class="price">
          <span class="amount">$—</span><span class="period muted">/mo, per company</span>
        </p>

        <ul class="included">
          <li>Payslip, letter, and details included.</li>
          <li>More people is not a second product.</li>
        </ul>

        <Button href="/demo" variant="filled">Book a demo</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    max-width: 30rem;
    margin-top: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .price-card {
    background: var(--color-card);
    border: 1px solid color-mix(in srgb, var(--color-gold) 35%, transparent);
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 4vw, 3rem);
    max-width: 28rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .amount {
    font-family: var(--font-heading);
    font-size: 3rem;
    color: var(--color-muted);
  }

  .period {
    font-size: 0.9375rem;
  }

  .included {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .included li {
    font-size: 0.9375rem;
    line-height: 1.5;
    padding-left: 1.1rem;
    position: relative;
  }

  .included li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-gold);
  }
</style>
